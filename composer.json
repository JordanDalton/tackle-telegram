{
    "name": "jordandalton/tackle-telegram",
    "description": "Drive a Laravel Tackle coding session from Telegram — outbound-only, so it works from anywhere with no public URL.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "ai", "tackle", "telegram"],
    "authors": [
        {
            "name": "Jordan Dalton",
            "email": "jordan.dalton@ymail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "jordandalton/laravel-tackle": "^1.46",
        "jordandalton/laravel-tackle-remote": "^0.1.3"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "TackleTelegram\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TackleTelegram\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["TackleTelegram\\TackleTelegramServiceProvider"]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
